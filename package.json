{
  "name": "apipuppy",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "npx --package typescript tsc --project ./",
    "cleanBuild": "run-script-os",
    "cleanBuild:linux:darwin": "rm -rf dist && npx --package typescript tsc --project ./",
    "cleanBuild:win32": "rmdir /Q /S dist && npx --package typescript tsc --project ./",
    "start": "node dist/src/index.js",
    "dev": "npm run build && npm run start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/axios": "^0.9.36",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "run-script-os": "^1.1.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@twurple/easy-bot": "^8.2.0",
    "axios": "^1.20.0",
    "obs-websocket-js": "^5.0.8",
    "tslog": "^5.2.0"
  },
  "license": "MIT"
}
